<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories (for example JS, CSS and images)
  # normally. All other requests belong to React Router and must start the
  # application through index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
